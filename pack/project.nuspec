<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
	<metadata>
		<id>${PROJECT_AUTHOR}.${PROJECT_NAME}</id>
		<version>$VERSION$</version>
		<authors>${PROJECT_AUTHOR}</authors>
		<description>${PROJECT_DESCRIPTION}</description>
		<tags>cpp native nativepackage header-only</tags>
		<projectUrl>https://github.com/${GITHUB_ORG}/${PROJECT_NAME}</projectUrl>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<license type="expression">BSD-3-Clause</license>
		<icon>docs\logo.png</icon>
		<readme>docs\README.md</readme>
		<releaseNotes>Refer to the project repository for release notes.</releaseNotes>
		<copyright>Copyright (c) 2026 ${PROJECT_AUTHOR}</copyright>
		<dependencies>
			<!-- Add package dependencies here -->
		</dependencies>
	</metadata>

	<files>
		<!-- includes -->
		<file src="..\include\**\*.hpp" target="build\native\include\" />
		<file src="logo.png" target="docs\" />
		<file src="..\README.md" target="docs\" />
		<file src="project.targets" target="build\native" />
	</files>
</package>
